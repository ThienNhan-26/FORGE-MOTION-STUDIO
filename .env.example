# Ollama local runtime
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss-20b-mxfp4:latest
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=240

# Workspace and storage (relative defaults are recommended)
# FORGE_WORKSPACE_DIR=D:\FORGE\workspace
# FORGE_STORAGE_DIR=D:\FORGE\storage

# Scheduler
FORGE_MAX_WORKERS=2
FORGE_MAX_ACTIVE_MISSIONS=1
FORGE_MAX_REPAIR_ROUNDS=2

# Safety: true allows FORGE to execute Python code generated by the local model.
# Script file path is confined to workspace, but Python is NOT an OS sandbox.
# Keep false until you understand and accept this risk.
FORGE_ENABLE_PYTHON_EXECUTION=false

# Optional Remotion / Blender overrides
# FORGE_REMOTION_DIR=D:\FORGE\adapters\remotion_template
# FORGE_BLENDER_EXECUTABLE=D:\Apps\Blender\blender.exe

# Motion Studio API is intentionally loopback-only
FORGE_MOTION_STUDIO_HOST=127.0.0.1
FORGE_MOTION_STUDIO_PORT=8765
